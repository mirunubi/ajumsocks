-- Client / PWA only. Copy to app/.env (gitignored).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Hosted example:
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Production PWA origin. Hosted Auth Site URL must match.
PUBLIC_APP_ORIGIN=https://app.ajumsocks.co.kr

# Local scripts / hosted bootstrap only. Never commit real values.
# LOCAL_DEV_PASSWORD=
# MASTER_BOOTSTRAP_PHONE=
# MASTER_BOOTSTRAP_PASSWORD=
# MASTER_BOOTSTRAP_DISPLAY_NAME=

# Never put Secret Key / BYPASSRLS credentials in VITE_ variables.
